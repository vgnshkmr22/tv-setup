<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the Settings menu (hold OK on Settings): a title and a status line under it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="7dp"
    android:paddingBottom="8dp"
    android:background="@drawable/input_row_bg"
    android:focusable="true"
    android:clickable="true">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@drawable/pill_text"
        android:duplicateParentState="true"
        android:textSize="15sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 500"
        android:singleLine="true"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@drawable/pill_text_mid"
        android:duplicateParentState="true"
        android:textSize="11sp"
        android:fontFamily="@font/outfit"
        android:maxLines="2" />
</LinearLayout>
